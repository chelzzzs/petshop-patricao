# Dados de contato do PatriCão. Copie para .env e preencha com os dados reais.
# O .env NÃO vai para o git. Em produção, cadastre as mesmas variáveis no painel da hospedagem.
# Se alguma ficar vazia/ausente, a página usa o placeholder definido em src/data/site.ts.
# No GitHub: Settings → Secrets and variables → Actions → aba Variables (mesmos nomes).

# WhatsApp com DDI + DDD, só números (ex: 5511987654321)
PETSHOP_WHATSAPP=5511900000000
# Telefone como deve aparecer na página
PETSHOP_PHONE=+55 11 90000-0000
# Usuário do Instagram, sem @
PETSHOP_INSTAGRAM=patricao.petshop
PETSHOP_ADDRESS_LINE=Rua dos Latidos, 123
PETSHOP_ADDRESS_DISTRICT=Vila Feliz · São Paulo

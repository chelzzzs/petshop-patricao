---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Products from '../components/Products.astro';
import Gallery from '../components/Gallery.astro';
import About from '../components/About.astro';
import Visit from '../components/Visit.astro';
import Footer from '../components/Footer.astro';
---

<Base>
  <Header />
  <main>
    <Hero />
    <Products />
    <Gallery />
    <About />
    <Visit />
  </main>
  <Footer />
</Base>

<script>
  import { mountShader } from '../scripts/shader';
  import { mountMascot } from '../scripts/mascot';
  import '../scripts/motion';

  const canvas = document.querySelector<HTMLCanvasElement>('[data-shader]');
  if (canvas) mountShader(canvas);

  document.querySelectorAll<HTMLElement>('[data-mascot]').forEach(mountMascot);
</script>

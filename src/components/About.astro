---
import { site } from '../data/site';

const words = site.about.statement.split(' ');
---

<section id="sobre" class="relative overflow-hidden bg-ink text-cream">
  <p aria-hidden="true" data-speed-x style="--speed-x:0.5" class="pointer-events-none absolute top-8 left-0 font-display text-[22vw] leading-none font-bold whitespace-nowrap text-transparent select-none [-webkit-text-stroke:1px_rgb(255_197_49/0.18)]">
    {site.name} · {site.name}
  </p>
  <div class="relative mx-auto grid max-w-6xl items-center gap-12 px-4 py-20 sm:px-6 sm:py-24 md:grid-cols-[1.3fr_1fr] md:py-36">
    <div>
      <p data-reveal class="font-display text-sm font-semibold tracking-[0.2em] text-sun uppercase">{site.about.kicker}</p>
      <p data-words class="mt-6 font-display text-3xl leading-tight font-semibold text-balance sm:text-5xl">
        {words.map((w) => <span data-word class="inline-block">{w}&nbsp;</span>)}
      </p>
    </div>
    <div data-reveal class="relative mx-auto w-full max-w-sm">
      <div data-speed style="--speed:-0.12" class="absolute -inset-3 rotate-6 rounded-[2.5rem] bg-sun"></div>
      <div class="relative overflow-hidden rounded-[2rem]">
        <img data-speed style="--speed:0.08" src={site.about.image.src} srcset={site.about.image.srcset} sizes="(min-width: 768px) 384px, 90vw" alt={site.about.alt} width="900" height="1100" loading="lazy" decoding="async" class="aspect-[4/5] w-full scale-110 object-cover" />
      </div>
    </div>
  </div>
</section>

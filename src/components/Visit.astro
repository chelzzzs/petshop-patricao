---
import Icon from './Icon.astro';
import { site, mapsLink } from '../data/site';
---

<section id="visite" class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24 md:py-32">
  <div data-reveal class="relative overflow-hidden rounded-[2.5rem] bg-white p-8 shadow-[0_30px_60px_-30px_rgb(20_18_16/0.3)] sm:p-12">
    <div data-speed style="--speed:0.3" class="absolute -top-24 -right-24 size-72 rounded-full bg-[radial-gradient(closest-side,rgb(255_197_49/0.45),transparent)]"></div>
    <div class="relative flex flex-col gap-8 md:flex-row md:items-center md:justify-between">
      <div>
        <h2 class="font-display text-3xl font-bold tracking-tight sm:text-5xl">Vem visitar a gente</h2>
        <p class="mt-3 flex items-start gap-2 text-base text-ink-soft sm:items-center sm:text-lg">
          <Icon name="MapPin" class="size-5 shrink-0 text-sun-deep" />
          {site.address.line} · {site.address.district}
        </p>
      </div>
      <div class="grid grid-cols-2 gap-3 sm:flex sm:flex-wrap">
        <button popovertarget="horarios" class="btn justify-center bg-sun px-4 whitespace-nowrap">
          <Icon name="Clock" class="size-5" /> Horários
        </button>
        <a href={mapsLink()} target="_blank" rel="noopener" class="btn justify-center px-4 whitespace-nowrap ring-2 ring-ink">
          Como chegar <Icon name="ArrowRight" class="hidden size-4 sm:block" />
        </a>
      </div>
    </div>
  </div>
</section>

<div id="horarios" popover class="pop m-auto w-[min(92vw,24rem)] rounded-[2rem] bg-cream p-8 text-ink shadow-2xl">
  <div class="flex items-center justify-between">
    <h3 class="font-display text-2xl font-bold">Horários</h3>
    <button popovertarget="horarios" popovertargetaction="hide" class="grid size-10 place-items-center rounded-full bg-ink text-cream" aria-label="Fechar">
      <Icon name="X" class="size-4" />
    </button>
  </div>
  <dl class="mt-6 divide-y divide-ink/10">
    {site.hours.map((h) => (
      <div class="flex justify-between py-3 text-lg">
        <dt class="text-ink-soft">{h.days}</dt>
        <dd class="font-display font-semibold">{h.time}</dd>
      </div>
    ))}
  </dl>
</div>

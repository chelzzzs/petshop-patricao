---
import Icon from './Icon.astro';
import Mascot from './Mascot.astro';
import { site, whatsappLink } from '../data/site';

// Camadas de patinhas ao fundo, cada uma com velocidade própria
const paws = [
  { pos: 'left-[6%] top-[18%]', size: 'size-10', rot: '-rotate-12', speed: '0.6' },
  { pos: 'left-[42%] top-[10%]', size: 'size-6', rot: 'rotate-12', speed: '0.85' },
  { pos: 'right-[8%] top-[12%]', size: 'size-14', rot: 'rotate-[24deg]', speed: '0.35' },
  { pos: 'left-[30%] bottom-[14%]', size: 'size-16', rot: '-rotate-[20deg]', speed: '0.2' },
  { pos: 'right-[28%] bottom-[8%]', size: 'size-8', rot: 'rotate-6', speed: '0.7' },
  { pos: 'left-[3%] bottom-[30%]', size: 'size-7', rot: 'rotate-45', speed: '0.5' },
];
---

<section id="topo" data-hero class="relative isolate flex min-h-svh items-center overflow-hidden pt-20">
  <canvas data-shader class="absolute inset-x-0 top-0 -z-10 h-[calc(100%-2px)] w-full bg-gradient-to-br from-cream via-sun/60 to-sun"></canvas>

  <div aria-hidden="true" class="hero-fade pointer-events-none absolute inset-0 -z-10 text-ink/10">
    {paws.map((p) => (
      <span data-speed style={`--speed:${p.speed}`} class={`absolute ${p.pos}`}>
        <Icon name="PawPrint" class={`${p.size} ${p.rot}`} />
      </span>
    ))}
  </div>

  <!-- Fade-out do fundo: termina na cor da página, sem corte no fim da seção -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-[45%] bg-gradient-to-b from-cream/0 via-cream/60 to-cream"></div>

  <div data-hero-content class="mx-auto grid w-full max-w-6xl items-center gap-10 px-4 pt-8 pb-16 sm:px-6 md:grid-cols-[1.1fr_1fr] md:gap-12 md:py-16">
    <div data-speed style="--speed:0.25" class="text-center md:text-left">
      <p data-hero-item class="inline-flex items-center gap-2 rounded-full bg-ink px-4 py-1.5 font-display text-sm font-medium text-sun">
        <Icon name="PawPrint" class="size-4" /> Pet shop · cães & gatos
      </p>
      <h1 data-hero-item class="mt-6 font-display text-[2.6rem] leading-[0.95] font-bold tracking-tight text-balance sm:text-6xl lg:text-7xl">
        {site.tagline}
      </h1>
      <p data-hero-item class="mx-auto mt-4 max-w-md text-base text-ink-soft sm:text-lg md:mx-0">{site.subline}</p>
      <div data-hero-item class="mt-8 flex flex-wrap justify-center gap-3 md:justify-start">
        <a href={whatsappLink()} target="_blank" rel="noopener" data-mascot-tease class="btn bg-ink text-cream">
          <Icon name="MessageCircle" class="size-5" /> Pedir pelo WhatsApp
        </a>
        <a href="#produtos" data-mascot-tease class="btn bg-white/85 ring-2 ring-ink">
          Ver produtos <Icon name="ArrowRight" class="size-4" />
        </a>
      </div>
    </div>

    <div data-speed style="--speed:0.45" class="relative mx-auto w-full max-w-[18rem] md:max-w-sm">
      <div data-hero-logo>
        <div class="float relative aspect-square">
          <Mascot />
        </div>
      </div>
    </div>
  </div>

  <a href="#produtos" class="absolute bottom-6 left-1/2 hidden -translate-x-1/2 flex-col items-center gap-1 font-display text-xs font-medium tracking-widest uppercase md:flex" aria-label="Rolar para produtos">
    <span class="h-10 w-6 rounded-full border-2 border-ink p-1"><span class="block h-2 w-full animate-bounce rounded-full bg-ink"></span></span>
  </a>
</section>

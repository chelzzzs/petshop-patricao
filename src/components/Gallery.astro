---
import { site } from '../data/site';

const tilt = ['-rotate-3', 'rotate-2', '-rotate-1', 'rotate-3'];
---

<section aria-label="Galeria" data-marquee class="marquee overflow-hidden py-8 [contain:paint] sm:py-10">
  <div data-speed-x style="--speed-x:-0.35" class="-ml-48">
  <ul class="marquee-track flex w-max gap-4 px-2 sm:gap-6 sm:px-3">
    {[...site.gallery, ...site.gallery].map((p, i) => (
      <li class={`${tilt[i % tilt.length]} shrink-0 transition-transform duration-500 ease-(--ease-spring) hover:z-10 hover:scale-110 hover:rotate-0`} aria-hidden={i >= site.gallery.length ? 'true' : undefined}>
        <img src={p.image.src} srcset={p.image.srcset} sizes="(min-width: 640px) 256px, 176px" alt={i >= site.gallery.length ? '' : p.alt} width="500" height="640" loading="lazy" decoding="async" fetchpriority="low" class="h-56 w-44 rounded-3xl object-cover shadow-md sm:h-80 sm:w-64 sm:shadow-xl" />
      </li>
    ))}
  </ul>
  </div>
</section>

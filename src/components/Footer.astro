---
import Icon from './Icon.astro';
import MaskedHeading from './MaskedHeading.astro';
import { site, whatsappLink } from '../data/site';

const year = new Date().getFullYear();
---

<section class="px-4 pb-6 sm:px-6">
  <div data-reveal class="relative isolate mx-auto flex max-w-6xl flex-col items-center gap-6 overflow-hidden rounded-[2.5rem] bg-ink px-6 py-16 text-center text-cream sm:py-24">
    <img
      src={site.cta.image.src}
      srcset={site.cta.image.srcset}
      sizes="(min-width: 1152px) 1152px, 100vw"
      alt={site.cta.alt}
      width="1600"
      height="1067"
      loading="lazy"
      decoding="async"
      class="absolute inset-0 -z-10 size-full object-cover"
    />
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-ink/80 via-ink/45 to-ink/30"></div>
    <MaskedHeading
      text={site.cta.title}
      gradient={site.cta.fill}
      ratio={0.5}
      fillScale={1.25}
      parallax={26}
      drift={18}
      duration={1.1}
      stagger={0.09}
      brightness={1}
      saturation={1}
      class="w-full font-display text-5xl leading-[1.06] font-bold tracking-[-0.03em] text-balance sm:text-7xl"
    />
    <a href={whatsappLink()} target="_blank" rel="noopener" class="btn-flip font-display text-lg font-semibold" aria-label="Chamar no WhatsApp">
      <span class="btn-flip-inner">
        <span class="btn-flip-face btn-flip-front"><Icon name="MessageCircle" /> Chamar no WhatsApp</span>
        <span class="btn-flip-face btn-flip-back" aria-hidden="true">Bora conversar <Icon name="ArrowRight" /></span>
      </span>
    </a>
  </div>
</section>

<footer class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-4 py-8 text-sm text-ink-soft sm:flex-row sm:px-6">
  <p>© {year} {site.name} · Fotos: <a href="https://unsplash.com" class="underline" target="_blank" rel="noopener">Unsplash</a></p>
  <div class="flex items-center gap-2">
    <a href={`https://instagram.com/${site.instagram}`} target="_blank" rel="noopener" class="grid size-10 place-items-center rounded-full ring-1 ring-ink/20 transition hover:bg-ink hover:text-cream" aria-label="Instagram">
      <Icon name="Camera" class="size-4" />
    </a>
    <a href={`tel:${site.phone.replace(/\D/g, '')}`} class="grid size-10 place-items-center rounded-full ring-1 ring-ink/20 transition hover:bg-ink hover:text-cream" aria-label={`Ligar para ${site.phone}`}>
      <Icon name="Phone" class="size-4" />
    </a>
  </div>
</footer>

---
import '@fontsource/fredoka/latin-500.css';
import '@fontsource/fredoka/latin-600.css';
import '@fontsource/fredoka/latin-700.css';
import '@fontsource/nunito/latin-400.css';
import '@fontsource/nunito/latin-600.css';
import '@fontsource/nunito/latin-700.css';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import { site } from '../data/site';
import logo from '../assets/logo.webp';

const favicon = await getImage({ src: logo, width: 64, height: 64, format: 'png' });
const ogImage = await getImage({ src: logo, width: 600, height: 600, format: 'jpeg' });

const title = `${site.name} · Pet Shop`;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={site.description} />
    <meta name="theme-color" content="#ffc531" />
    <link rel="icon" type="image/png" href={favicon.src} />
    <link rel="apple-touch-icon" href={favicon.src} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:image" content={new URL(ogImage.src, Astro.site).href} />
    <meta property="og:locale" content="pt_BR" />

    <link rel="preconnect" href="https://images.unsplash.com" />
    <script is:inline>
      // Esconde os elementos animados só enquanto o JS de animação carrega. Se ele não rodar em 2,5s
      // (falha de rede, bloqueio), tira a classe e o conteúdo aparece sem animação.
      document.documentElement.classList.add('js');
      setTimeout(() => window.__motionReady || document.documentElement.classList.remove('js'), 2500);
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
